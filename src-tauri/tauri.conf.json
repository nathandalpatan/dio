{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIO",
  "version": "0.1.0",
  "identifier": "app.dio.dictionary",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "DIO",
        "width": 340,
        "height": 200,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/english.sqlite3", "resources/DICTIONARY-LICENSE.md"],
    "targets": [
      "nsis"
    ],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
