{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DIO",
  "version": "0.1.1",
  "identifier": "app.dio.dictionary",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popup",
        "title": "DIO",
        "width": 340,
        "height": 200,
        "visible": false,
        "focus": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "minWidth": 300,
        "minHeight": 220
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "resources": ["resources/english.sqlite3", "resources/acronyms.sqlite3", "resources/pronunciations.sqlite3", "resources/onnxruntime.dll", "resources/DICTIONARY-LICENSE.md", "resources/ACRONYM-LICENSE.md", "resources/PRONUNCIATION-LICENSE.md", "resources/SPEECH-LICENSE.md", "resources/ONNXRUNTIME-LICENSE.txt", "resources/ONNXRUNTIME-THIRD-PARTY-NOTICES.txt"],
    "targets": [
      "nsis"
    ],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4M0U3N0NDOTFCNTFCMzAKUldRd0c3V1J6SGMrU054Nm5LT3pFWGc3NXNoOTJTQ0F2NWdibUtqcDdJRk0wNzl1TjgzRmUxT28K",
      "endpoints": ["https://github.com/nathandalpatan/dio/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
